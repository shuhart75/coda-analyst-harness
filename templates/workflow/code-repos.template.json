{
  "schema_version": 3,
  "workspace": {
    "layout": "sibling-clones",
    "analytical_repository": {
      "id": "analytics",
      "repository_id": "documents",
      "accepted_remote_urls": [
        "ssh://sc@api.sc-ci.sber.ru:7998/RSCON/documents.git"
      ]
    }
  },
  "repositories": [
    {
      "id": "code",
      "repository_id": "coda",
      "purpose": "Исходный код АС КОДА",
      "access": "read-only",
      "write_policy": {
        "mode": "operations-only",
        "allowed_paths": [
          "requirements-exchange/**"
        ],
        "allowed_operations": [
          "initial-clone",
          "git-pull-ff-only-via-workspace",
          "requirements-exchange-publish-via-isolated-clone"
        ],
        "user_prompt_can_override": false
      },
      "location": {
        "environment": "CODA_REPO",
        "relative_to_analytical": "../coda"
      },
      "accepted_remote_urls": [
        "ssh://sc@api.sc-ci.sber.ru:7998/RSCON/coda.git"
      ],
      "expected_branch": null,
      "contours": {
        "backend": {
          "path": "backend"
        },
        "frontend": {
          "path": "frontend"
        }
      },
      "instruction_patterns": [
        "AGENTS.md",
        "**/AGENTS.md",
        "CLAUDE.md",
        "**/CLAUDE.md",
        "openspec/README.md",
        "**/openspec/README.md",
        ".sdd/README.md",
        "**/.sdd/README.md"
      ]
    }
  ]
}
