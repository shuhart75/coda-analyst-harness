{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Workflow: Planning",
      "type": "shell",
      "command": "bash ${workspaceFolder:analyst-harness}/adapters/cli/switch-mode.sh planning"
    },
    {
      "label": "Workflow: Requirements",
      "type": "shell",
      "command": "bash ${workspaceFolder:analyst-harness}/adapters/cli/switch-mode.sh requirements"
    },
    {
      "label": "Workflow: Scope Prototype",
      "type": "shell",
      "command": "bash ${workspaceFolder:analyst-harness}/adapters/cli/switch-mode.sh scope-prototype"
    },
    {
      "label": "Workflow: Delivery Prototype",
      "type": "shell",
      "command": "bash ${workspaceFolder:analyst-harness}/adapters/cli/switch-mode.sh delivery-prototype"
    },
    {
      "label": "Workflow: Execution Update",
      "type": "shell",
      "command": "bash ${workspaceFolder:analyst-harness}/adapters/cli/switch-mode.sh execution-update"
    },
    {
      "label": "Workflow: Release Finalization",
      "type": "shell",
      "command": "bash ${workspaceFolder:analyst-harness}/adapters/cli/switch-mode.sh release-finalization"
    },
    {
      "label": "Workflow: Validate Structure",
      "type": "shell",
      "command": "python3 ${workspaceFolder:analyst-harness}/scripts/validate-structure.py ${workspaceFolder:documents}"
    },
    {
      "label": "Workflow: Validate Links",
      "type": "shell",
      "command": "python3 ${workspaceFolder:analyst-harness}/scripts/validate-links.py ${workspaceFolder:documents}"
    },
    {
      "label": "Workflow: Doctor",
      "type": "shell",
      "command": "python3 ${workspaceFolder:analyst-harness}/scripts/harnessctl.py doctor ${workspaceFolder:documents}"
    },
    {
      "label": "Workflow: Session Brief",
      "type": "shell",
      "command": "python3 ${workspaceFolder:analyst-harness}/scripts/harnessctl.py session-brief ${workspaceFolder:documents}"
    },
    {
      "label": "Workflow: Generate Draft Plan",
      "type": "shell",
      "command": "python3 ${workspaceFolder:analyst-harness}/scripts/sync-planning-gantt.py ${workspaceFolder:documents} ${input:quarterId}"
    }
  ],
  "inputs": [
    {
      "id": "quarterId",
      "type": "promptString",
      "description": "Quarter id",
      "default": "2026-Q3"
    }
  ]
}
